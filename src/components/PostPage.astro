---
/**
 * Post layout — /YYYY/MM/DD/slug/ (date-based, no locale prefix).
 * 66ch measure, Fraunces headings, amber-rule blockquotes (same family as
 * the thesis block), Shiki highlighting themed to the palette, mono metadata
 * with tabular numerals, translation cross-link, canonicalUrl support,
 * Article JSON-LD. 0KB JS: no scripts on this page, ever.
 */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getDict, absoluteUrl, homePath, type Locale } from '../i18n/utils';
import { getTranslation, postPath, readingMinutes, type Post } from '../lib/posts';

interface Props {
  locale: Locale;
  post: Post;
}

const { locale, post } = Astro.props;
const d = getDict(locale);
const { Content } = await render(post);

const translation = await getTranslation(post);
const translationPath = translation ? postPath(translation) : undefined;

// The locale switcher must land on the equivalent page: the translation when
// it exists, the other locale's index otherwise — never a 404, never home.
const indexPath = locale === 'es' ? '/es/ideas/' : '/ideas/';
const alternates =
  locale === 'es'
    ? { en: translationPath ?? '/ideas/', es: postPath(post) }
    : { en: postPath(post), es: translationPath ?? '/es/ideas/' };

// Post dates are calendar dates, not instants: format in UTC so the written
// date is honored regardless of the build machine's timezone.
const dateLocale = locale === 'es' ? 'es-CO' : 'en-US';
const dateFmt = new Intl.DateTimeFormat(dateLocale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const minutes = readingMinutes(post.body ?? '');
const canonicalHost = post.data.canonicalUrl
  ? new URL(post.data.canonicalUrl).host
  : undefined;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString().slice(0, 10),
  inLanguage: post.data.lang,
  url: absoluteUrl(Astro.site!, postPath(post)),
  ...(post.data.canonicalUrl && { isBasedOn: post.data.canonicalUrl }),
  author: {
    '@type': 'Person',
    name: 'Aníbal Rojas',
    url: absoluteUrl(Astro.site!, homePath(locale)),
  },
};
---

<Base
  title={`${post.data.title} · Aníbal Rojas`}
  description={post.data.description}
  canonicalOverride={post.data.canonicalUrl}
  alternates={alternates}
  localeOverride={locale}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />

  <article class="post">
    <header class="post-head">
      <span class="eyebrow"><a href={indexPath}>{d.ideasPage.eyebrow}</a></span>
      {/* The title is the LCP candidate: no load animation, paint is never
          gated by motion (brain: lcp-element-motion-constraint). */}
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {dateFmt.format(post.data.date)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{minutes} {d.post.minuteRead}</span>
        {post.data.tags.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <span>{post.data.tags.join(', ')}</span>
          </>
        )}
      </p>
      {translationPath && (
        <p class="cross-link">
          <a href={translationPath} hreflang={translation!.data.lang}>{d.post.alsoIn}&nbsp;→</a>
        </p>
      )}
      {post.data.canonicalUrl && canonicalHost && (
        <p class="cross-link">
          {d.post.originally}{' '}
          <a href={post.data.canonicalUrl} rel="canonical">{canonicalHost}</a>
        </p>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    padding: var(--space-6) var(--space-3) var(--space-6);
  }
  .post-head,
  .prose {
    max-width: var(--prose);
    margin: 0 auto;
  }
  /* the eyebrow is the quiet way back to the index */
  .post-head .eyebrow a {
    color: inherit;
  }
  .post-head h1 {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 640;
    font-size: var(--text-h2-lg);
    line-height: var(--leading-display);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .post-head .meta {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .cross-link {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text--1);
    color: var(--muted);
  }
  .cross-link a {
    color: var(--muted);
    /* quiet-mono register: one hover physics (constitution, ruling C4) */
    background-image: none;
    transition: color var(--dur-1) var(--ease);
  }
  .cross-link a:hover {
    color: var(--amber);
  }

  /* ---------- prose: markdown output (scoped styles can't reach it, so
     descendants are :global under .prose — still page-local CSS) ---------- */
  .prose {
    margin-top: var(--space-4);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre),
  .prose :global(figure),
  .prose :global(table) {
    margin-top: var(--space-2);
  }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin-top: var(--space-4);
  }
  .prose :global(h2) {
    font-weight: 560;
    font-size: var(--text-2);
    line-height: 1.25;
  }
  .prose :global(h3) {
    font-weight: 560;
    font-size: var(--text-1);
    line-height: 1.3;
  }
  .prose :global(h4) {
    font-weight: 600;
    font-size: var(--text-0);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-3);
  }
  .prose :global(li + li) {
    margin-top: var(--space-1);
  }
  .prose :global(li::marker) {
    color: var(--amber);
  }

  /* blockquotes: amber left rule — same family as the thesis block */
  .prose :global(blockquote) {
    border-left: 3px solid var(--amber);
    background: var(--card);
    padding: var(--space-2) var(--space-3);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .prose :global(blockquote p) {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-style: italic;
    font-size: var(--text-lede);
    line-height: 1.5;
  }
  .prose :global(blockquote p + p) {
    margin-top: var(--space-2);
  }

  /* code: Shiki at build, themed to the palette (shiki-theme.json) */
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  .prose :global(p code),
  .prose :global(li code),
  .prose :global(td code) {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.35em;
  }
  .prose :global(pre) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: var(--text--1);
    line-height: 1.6;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  /* figures + captions */
  .prose :global(figure) {
    margin-left: 0;
    margin-right: 0;
  }
  .prose :global(figcaption) {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text--1);
    color: var(--muted);
  }
  .prose :global(img) {
    /* width/height attrs come from the build (rehype-image-dimensions);
       height:auto keeps the aspect ratio when max-width constrains them. */
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: var(--space-4) 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-ui);
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: var(--space-1) var(--space-2) var(--space-1) 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
</style>
