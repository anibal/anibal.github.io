---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocale, getDict, equivalentPath, homePath, absoluteUrl } from '../i18n/utils';
import { type Locale } from '../i18n/ui';
import '../styles/fonts.css';
import '../styles/font-overrides.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  /** Page-specific title; defaults to the site meta title. */
  title?: string;
  /** Page-specific description; defaults to the site meta description. */
  description?: string;
  /** Canonical URL override — republished posts point at the original. */
  canonicalOverride?: string;
  /**
   * Explicit EN/ES path pair for pages whose equivalence the route map
   * can't know (posts with `translationOf`, untranslated posts → index).
   */
  alternates?: { en: string; es: string };
  /** Override locale for pages where the URL doesn't encode it (date-based posts). */
  localeOverride?: Locale;
  /** The contact page sets this false — its body already is the footer CTA. */
  footerCta?: boolean;
}

const locale = Astro.props.localeOverride ?? getLocale(Astro.url);
const d = getDict(locale);
const title = Astro.props.title ?? d.meta.title;
const description = Astro.props.description ?? d.meta.description;

const site = Astro.site!;
const canonical = Astro.props.canonicalOverride ?? absoluteUrl(site, Astro.url.pathname);
const enPath = Astro.props.alternates?.en ?? equivalentPath(Astro.url.pathname, 'en');
const esPath = Astro.props.alternates?.es ?? equivalentPath(Astro.url.pathname, 'es');
const enUrl = absoluteUrl(site, enPath);
const esUrl = absoluteUrl(site, esPath);

function ogImagePath(pathname: string): string {
  const trimmed = pathname.replace(/^\/|\/$/g, '');
  if (!trimmed) return 'home';
  if (trimmed === 'es') return 'es/home';
  return trimmed;
}
const ogImage = absoluteUrl(site, `/og/${ogImagePath(Astro.url.pathname)}.png`);

// JSON-LD: Person, sitewide (handoff §8)
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aníbal Rojas',
  url: absoluteUrl(site, homePath(locale)),
  jobTitle: 'Engineering Leadership Advisor',
  address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
  sameAs: [
    'https://www.linkedin.com/in/anibalrojas/',
    'https://anibal.substack.com/',
    'https://ocorres.com',
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F7F3" />

    {/* fonts: preloaded so they beat font-display: optional's ~100ms window on
        real connections; metric-matched fallbacks (font-overrides.css) keep any
        miss layout-invisible (CLS = 0). See brain: font-loading-strategy. */}
    <link rel="preload" href="/fonts/fraunces-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low" />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low" />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low" />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* RSS, current locale's feed (handoff §6.4) */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={d.ideasPage.meta.title}
      href={locale === 'es' ? '/es/rss.xml' : '/rss.xml'}
    />

    {/* canonical + hreflang pair (handoff §4) */}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aníbal Rojas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    {/* page-level head extras: JSON-LD types, etc. */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.a11y.skip}</a>
    <Header alternates={Astro.props.alternates} localeOverride={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer cta={Astro.props.footerCta} />
  </body>
</html>
